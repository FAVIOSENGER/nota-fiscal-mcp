{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.faviosenger/nota-fiscal-mcp",
  "description": "Emissao, consulta e cancelamento de NF-e e NFS-e no Brasil para agentes de IA, via Focus NFe.",
  "repository": {
    "url": "https://github.com/FAVIOSENGER/nota-fiscal-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "nota-fiscal-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FOCUS_NFE_TOKEN",
          "description": "Token da conta Focus NFe (homologacao ou producao).",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "FOCUS_NFE_AMBIENTE",
          "description": "Ambiente: 'homologacao' (padrao) ou 'producao'.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
